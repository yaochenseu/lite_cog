#!/usr/bin/env bash
set -euo pipefail

bundle_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
case "${1:---help}" in
  -h|--help)
    echo '用法: ./run {wake|stt|tts|check} [参数]'
    echo 'wake: 唤醒和方向角度  stt: 语音识别  tts: 合成播报  check: 本地环境检查'
    exit 0
    ;;
  wake) entry=wake/m260c_wake.py ;;
  stt) entry=Speech_to_Text/stt.py ;;
  tts) entry=Text_to_Speech/tts.py ;;
  check) entry=check.py ;;
  *) echo "未知模块: $1" >&2; exit 2 ;;
esac
shift
if [[ ! -x "$bundle_dir/.venv/bin/python3" ]]; then
  echo '请先在 Jetson 上运行 bash install.sh。' >&2
  exit 1
fi
exec "$bundle_dir/.venv/bin/python3" "$bundle_dir/$entry" "$@"
