<launch>
  <arg name="map_dir" default="/home/ysc/lite_cog/system/map"/>
  <arg name="map_name" default="lite3"/>
  <arg name="rviz" default="true"/>
  <arg name="localization" default="true"/>
  <arg name="output_topic" default="/cmd_vel"/>
  <arg name="test_hooks" default="false"/>
  <!-- Startup-only switch shared by manager, gate and controller. -->
  <arg name="task_lease_watchdog" default="false"/>
  <arg name="localization_timeout" default="1.2"/>
  <arg name="localization_retries" default="3"/>
  <arg name="localization_retry_wait" default="3.0"/>
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_z" default="0.0"/>
  <arg name="init_yaw" default="0.0"/>
  <include file="$(find scan_map_navigation)/launch/localization.launch" if="$(arg localization)">
    <arg name="map_dir" value="$(arg map_dir)"/>
    <arg name="map_name" value="$(arg map_name)"/>
    <arg name="init_x" value="$(arg init_x)"/>
    <arg name="init_y" value="$(arg init_y)"/>
    <arg name="init_z" value="$(arg init_z)"/>
    <arg name="init_yaw" value="$(arg init_yaw)"/>
  </include>
  <!-- Static-map rollback: no runtime-map publisher or freshness dependency. -->
  <node pkg="scan_map_navigation" type="map_global_planner" name="scan_global" output="screen" required="true">
    <rosparam command="load" file="$(find scan_map_navigation)/config/global.yaml"/>
    <param name="global_costmap/transform_tolerance" value="$(arg localization_timeout)"/>
  </node>
  <include file="$(find scan_map_navigation)/launch/scan_local.launch">
    <arg name="test_hooks" value="$(arg test_hooks)"/>
    <arg name="task_lease_watchdog" value="$(arg task_lease_watchdog)"/>
  </include>
  <node pkg="scan_map_navigation" type="navigator.py" name="scan_navigator" output="screen" required="true">
    <param name="task_lease_watchdog" value="$(arg task_lease_watchdog)" type="bool"/>
    <rosparam command="load" file="$(find scan_map_navigation)/config/rolling.yaml"/>
    <param name="localization_timeout" value="$(arg localization_timeout)"/>
    <param name="localization_retries" value="$(arg localization_retries)"/>
    <param name="localization_retry_wait" value="$(arg localization_retry_wait)"/>
    <param name="test_hooks" value="$(arg test_hooks)"/>
  </node>
  <node pkg="scan_map_navigation" type="velocity_gate.py" name="scan_velocity_gate" output="screen" required="true">
    <param name="task_lease_watchdog" value="$(arg task_lease_watchdog)" type="bool"/>
    <param name="output_topic" value="$(arg output_topic)"/>
    <param name="lease_recovery_timeout" value="2.0"/>
    <param name="localization_timeout" value="$(arg localization_timeout)"/>
  </node>
  <node pkg="rviz" type="rviz" name="scan_map_rviz" if="$(arg rviz)"
        args="-d $(find scan_map_navigation)/config/navigation.rviz"/>
</launch>
